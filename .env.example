# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
APP_NAME=MediPredict
APP_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REQUIRE_VERIFIED_EMAIL=false
# Optional SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://medipredict:change-me@localhost:5432/medipredict
CORS_ORIGINS=http://localhost:3000

# Optional research model artifact paths (configuration only; no loading or inference is enabled).
# Keep artifacts in trusted, access-controlled storage. Use absolute paths only.
# SKIN_RESEARCH_CHECKPOINT_PATH=
# TEXT_RESEARCH_ARTIFACT_PATH=

# Optional private skin-image storage. Leave unset to keep uploads disabled.
# Use an AWS region and a private bucket with Block Public Access and least-privilege IAM.
SKIN_IMAGE_S3_BUCKET=
SKIN_IMAGE_S3_REGION=
# Custom S3-compatible endpoint must use HTTPS.
SKIN_IMAGE_S3_ENDPOINT_URL=
SKIN_IMAGE_S3_ENCRYPTION=AES256
# Required only when SKIN_IMAGE_S3_ENCRYPTION=aws:kms
SKIN_IMAGE_S3_KMS_KEY_ID=
